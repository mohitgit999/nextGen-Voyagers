# NextGen Voyagers — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────
# Local MongoDB (default):
MONGO_URI=mongodb://127.0.0.1:27017/nextgen-voyagers

# MongoDB Atlas (cloud — uncomment and paste your connection string):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nextgen-voyagers?retryWrites=true&w=majority

# ── CORS ────────────────────────────────────────────────
# Frontend origin (for local dev, the file:// protocol or a local server)
FRONTEND_URL=http://localhost:3000

# ── Session ─────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-secret-string-in-production
